# Supabase (бэкенд читает PG* и PGSSLMODE; DATABASE_URL зарезервирован для скриптов)
PGHOST=aws-0-eu-central-1.pooler.supabase.com
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require
DATABASE_URL=

# Ключ шифрования ПДн (обязательно, не короче 16 символов)
PII_KEY=

# Отчёты и бэкапы
REPORTS_HOST=127.0.0.1
REPORTS_PORT=4000
PYTHON_BIN=python3
FARM_PSQL_MODE=local
FARM_BACKUP_DIR=/app/backups
BACKUP_SCHEDULER=on

# Фронтенд ( GitHub Pages )
API_BASE_URL=https://api.zarechnoe.dpdns.org/api/v1
